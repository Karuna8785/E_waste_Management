# EcoCycle AI Backend Configuration Example
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-change-in-production-ecocycle-ai-2026
JWT_SECRET_KEY=jwt-secret-key-change-in-production-ecocycle-ai-2026

# Database URI (Defaults to SQLite for local development, use PostgreSQL in production)
DATABASE_URL=sqlite:///ecocycle.db
# DATABASE_URL=postgresql://ecocycle_user:secure_password@localhost:5432/ecocycle_db

# File Storage
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload

# AI Service Configuration
AI_MODEL_CONFIDENCE_THRESHOLD=0.65
AI_FALLBACK_MODE=heuristic  # 'heuristic' or 'deep_learning'

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
